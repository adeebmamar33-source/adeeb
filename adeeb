                price: 530000,
                priceFormatted: "530,000",
                tag: "أصلي 100% 🇪🇺",
                features: ["خفيف للركض والجيم", "تهوية ممتازة", "NWT"],
                image: "https://placehold.co/600x600/1e293b/ec4899?text=Nike+Zoom+Pegasus"
            }
        ];

        const brandsList = ["الكل", "Nike", "Adidas", "Puma", "Skechers", "Salomon", "New Balance", "Reebok"];
        const sizesList = ["الكل", 39, 40, 40.5, 41, 42, 42.5, 43, 44, 45];

        let activeBrand = "الكل";
        let activeSize = "الكل";
        let cart = [];

        // App Initialization
        window.onload = function() {
            renderBrandFilters();
            renderSizeFilters();
            applyFilters();
        };

        // Render Brand Filter Buttons
        function renderBrandFilters() {
            const container = document.getElementById('brand-filters');
            container.innerHTML = brandsList.map(brand => {
                const isActive = activeBrand === brand;
                const activeClasses = isActive ? 'bg-amber-500 text-slate-950 font-black shadow' : 'bg-slate-900 text-slate-300 border border-slate-800 hover:border-amber-400';
                return `<button onclick="setBrand('${brand}')" class="px-4 py-2 rounded-xl whitespace-nowrap transition ${activeClasses}">${brand}</button>`;
            }).join('');
        }

        // Render Size Filter Buttons
        function renderSizeFilters() {
            const container = document.getElementById('size-filters');
            container.innerHTML = sizesList.map(size => {
                const isActive = activeSize === size;
                const activeClasses = isActive ? 'bg-amber-500 text-slate-950 font-black shadow' : 'bg-slate-900 text-slate-300 border border-slate-800 hover:border-amber-400';
                return `<button onclick="setSize('${size}')" class="px-3 py-1.5 rounded-lg whitespace-nowrap transition ${activeClasses}">${size === 'الكل' ? 'جميع المقاسات' : 'مقاس ' + size}</button>`;
            }).join('');
        }

        function setBrand(brand) {
            activeBrand = brand;
            renderBrandFilters();
            applyFilters();
        }

        function setSize(size) {
            activeSize = size === 'الكل' ? 'الكل' : parseFloat(size);
            renderSizeFilters();
            applyFilters();
        }

        function resetFilters() {
            activeBrand = "الكل";
            activeSize = "الكل";
            document.getElementById('search-input').value = "";
            renderBrandFilters();
            renderSizeFilters();
            applyFilters();
        }

        // Filter Products Engine
        function applyFilters() {
            const searchVal = document.getElementById('search-input').value.toLowerCase().trim();
            
            const filtered = productsData.filter(product => {
                const matchesBrand = (activeBrand === "الكل") || (product.brand.toLowerCase() === activeBrand.toLowerCase());
                const matchesSize = (activeSize === "الكل") || (product.sizes.includes(activeSize));
                const matchesSearch = searchVal === "" || 
                    product.name.toLowerCase().includes(searchVal) || 
                    product.brand.toLowerCase().includes(searchVal) ||
                    product.features.some(f => f.toLowerCase().includes(searchVal));

                return matchesBrand && matchesSize && matchesSearch;
            });

            renderProducts(filtered);
            document.getElementById('result-count').innerText = filtered.length;
        }

        // Render Product Cards
        function renderProducts(products) {
            const grid = document.getElementById('product-grid');
            const noResults = document.getElementById('no-results');

            if (products.length === 0) {
                grid.innerHTML = "";
                noResults.classList.remove('hidden');
                return;
            }

            noResults.classList.add('hidden');
            grid.innerHTML = products.map(product => {
                const sizeBadges = product.sizes.map(s => 
                    `<span class="bg-slate-800 text-slate-300 text-[10px] font-semibold px-2 py-0.5 rounded border border-slate-700">${s}</span>`
                ).join('');

                const featurePills = product.features.map(f => 
                    `<span class="text-[10px] text-amber-300 bg-amber-400/10 px-2 py-0.5 rounded border border-amber-400/20">✓ ${f}</span>`
                ).join(' ');

                return `
                <div class="bg-slate-900 rounded-2xl border border-slate-800 hover:border-amber-500/50 transition duration-300 overflow-hidden flex flex-col justify-between group shadow-lg">
                    <div>
                        <!-- Image Container -->
                        <div class="relative overflow-hidden bg-slate-950 aspect-square">
                            <img src="${product.image}" alt="${product.name}" class="w-full h-full object-cover group-hover:scale-105 transition duration-500">
                            <span class="absolute top-3 right-3 bg-slate-950/90 text-amber-400 text-[11px] font-bold px-2.5 py-1 rounded-full border border-amber-500/30 backdrop-blur-sm">
                                ${product.tag}
                            </span>
                        </div>

                        <!-- Card Content -->
                        <div class="p-4 space-y-2">
                            <div class="text-[11px] font-bold text-amber-400 uppercase tracking-wider">${product.brand}</div>
                            <h3 class="font-extrabold text-slate-100 text-base leading-snug">${product.name}</h3>
                            
                            <!-- Features -->
                            <div class="flex flex-wrap gap-1 pt-1">
                                ${featurePills}
                            </div>

                            <!-- Sizes -->
                            <div class="pt-2">
                                <span class="text-[11px] text-slate-400 block mb-1 font-bold">المقاسات المتوفرة:</span>
                                <div class="flex flex-wrap gap-1">
                                    ${sizeBadges}
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Price & Action Footer -->
                    <div class="p-4 border-t border-slate-800/80 bg-slate-950/50 space-y-2.5">
                        <div class="flex items-center justify-between">
                            <span class="text-xs text-slate-400 font-bold">السعر:</span>
                            <span class="text-lg font-black text-amber-400">${product.priceFormatted} <span class="text-xs font-normal text-slate-400">ل.س</span></span>
                        </div>

                        <!-- Quick Action Buttons -->
                        <div class="grid grid-cols-2 gap-2">
                            <button onclick="directWhatsAppOrder(${product.id})" class="bg-emerald-600 hover:bg-emerald-500 text-white font-bold py-2 px-2 rounded-xl transition text-xs flex items-center justify-center gap-1">
                                <i class="fa-brands fa-whatsapp text-base"></i>
                                <span>طلب مباشر</span>
                            </button>
                            <button onclick="addToCart(${product.id})" class="bg-slate-800 hover:bg-slate-700 text-amber-400 font-bold py-2 px-2 rounded-xl transition text-xs border border-slate-700 flex items-center justify-center gap-1">
                                <i class="fa-solid fa-cart-plus text-sm"></i>
                                <span>أضف للسلة</span>
                            </button>
                        </div>
                    </div>
                </div>
                `;
            }).join('');
        }

        // Direct WhatsApp Single Item Order
        function directWhatsAppOrder(productId) {
            const product = productsData.find(p => p.id === productId);
            if (!product) return;

            const sizesText = product.sizes.join(' / ');
            const message = `مرحباً الجانودي أوتلت 👋\nحابب استفسر / أحجز حذاء:\n👟 *${product.name}*\n🏷️ *الماركة:* ${product.brand}\n📏 *المقاس المتوفر:* (${sizesText})\n💰 *السعر:* ${product.priceFormatted} ل.س\n\nهل المنتج متوفر حتى ثبت الطلب؟`;
            
            const whatsappUrl = `https://wa.me/963981057508?text=${encodeURIComponent(message)}`;
            window.open(whatsappUrl, '_blank');
        }

        // Cart Management
        function addToCart(productId) {
            const product = productsData.find(p => p.id === productId);
            if (!product) return;

            const existingIndex = cart.findIndex(item => item.id === productId);
            if (existingIndex > 0) {
                cart[existingIndex].quantity += 1;
            } else {
                cart.push({ ...product, selectedSize: product.sizes[0], quantity: 1 });
            }

            updateCartUI();
            openCartModal();
        }

        function removeFromCart(productId) {
            cart = cart.filter(item => item.id !== productId);
            updateCartUI();
        }

        function updateCartUI() {
            const cartCountBadge = document.getElementById('cart-count');
            const cartItemsContainer = document.getElementById('cart-items');
            const cartTotalEl = document.getElementById('cart-total');

            cartCountBadge.innerText = cart.length;

            if (cart.length === 0) {
                cartItemsContainer.innerHTML = `
                    <div class="text-center py-8 text-slate-500 text-xs">
                        <i class="fa-solid fa-basket-shopping text-3xl mb-2"></i>
                        <p>السلة فارغة حالياً!</p>
                    </div>
                `;
                cartTotalEl.innerText = "0 ل.س";
                return;
            }

            let total = 0;
            cartItemsContainer.innerHTML = cart.map((item, index) => {
                total += item.price * item.quantity;
                return `
                    <div class="bg-slate-950 p-3 rounded-xl border border-slate-800 flex items-center justify-between gap-3 text-xs">
                        <div class="flex items-center gap-3">
                            <img src="${item.image}" class="w-12 h-12 rounded-lg object-cover bg-slate-900">
                            <div>
                                <h4 class="font-extrabold text-slate-200">${item.name}</h4>
                                <div class="text-amber-400 font-bold">${item.priceFormatted} ل.س</div>
                                <div class="text-[10px] text-slate-400 mt-0.5">
                                    المقاس المطلوب: 
                                    <select onchange="updateCartSize(${index}, this.value)" class="bg-slate-900 text-amber-300 border border-slate-700 rounded px-1 py-0.5 text-[10px]">
                                        ${item.sizes.map(s => `<option value="${s}" ${s === item.selectedSize ? 'selected' : ''}>${s}</option>`).join('')}
                                    </select>
                                </div>
                            </div>
                        </div>
                        <button onclick="removeFromCart(${item.id})" class="text-red-400 hover:text-red-300 p-2">
                            <i class="fa-solid fa-trash-can text-sm"></i>
                        </button>
                    </div>
                `;
            }).join('');

            cartTotalEl.innerText = total.toLocaleString() + " ل.س";
        }

        function updateCartSize(index, newSize) {
            if (cart[index]) {
                cart[index].selectedSize = parseFloat(newSize);
            }
        }

        function openCartModal() {
            document.getElementById('cart-modal').classList.remove('hidden');
        }

        function closeCartModal() {
            document.getElementById('cart-modal').classList.add('hidden');
        }

        // Send Entire Cart to WhatsApp
        function sendCartToWhatsApp() {
            if (cart.length === 0) {
                alert("السلة فارغة! يرجى إضافة قطع أولاً.");
                return;
            }

            let itemsListText = "";
            let totalPrice = 0;

            cart.forEach((item, i) => {
                totalPrice += item.price * item.quantity;
                itemsListText += `${i + 1}. *${item.name}* - مقاس: [${item.selectedSize}] - السعر: ${item.priceFormatted} ل.س\n`;
            });

            const message = `مرحباً الجانودي أوتلت 👋\nحابب اطلب القائمة التالية من الأحذية:\n\n${itemsListText}\n💰 *المجموع التقديري:* ${totalPrice.toLocaleString()} ل.س\n\n📌 *خيارات الشحن والدفع:* (شام كاش / الهرم)\nيرجى تأكيد المتوفر من المقاسات لتثبيت الحجز.`;

            const whatsappUrl = `https://wa.me/963981057508?text=${encodeURIComponent(message)}`;
            window.open(whatsappUrl, '_blank');
        }
    </script>
</body>
</html>
